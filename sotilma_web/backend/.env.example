# ============================================================
# FICHIER : .env.example
# Copiez ce fichier en .env et remplissez les valeurs.
# Ne committez JAMAIS votre .env réel dans Git !
# ============================================================

# ── Serveur ─────────────────────────────────────────────────
PORT=4000

# Origines autorisées pour CORS (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:3000

# ── Firebase Admin ──────────────────────────────────────────
# Récupérez ces valeurs dans Firebase Console →
# Paramètres du projet → Comptes de service → Générer une clé privée
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id

# ── Email (SMTP) ─────────────────────────────────────────────
# Exemple avec Gmail : activez "Mots de passe d'application" dans votre compte Google
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-email@gmail.com
SMTP_PASS=votre-mot-de-passe-application

# Email qui reçoit les messages de contact
CONTACT_RECIPIENT_EMAIL=contact@sotilma.com
